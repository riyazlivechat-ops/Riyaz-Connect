# Postgres connection string (Neon, Supabase, Railway, Render all give you one)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/riyaz_connect
# Set to true for hosted Postgres that requires SSL
PGSSL=false
# Password for the private dashboard at /admin
ADMIN_PASSWORD=change-me
# Long random string; keeps you signed in across restarts. Generate: openssl rand -hex 32
SESSION_SECRET=
# The public address of the app. The QR code points here.
PUBLIC_URL=https://connect.example.com
NODE_ENV=production
PORT=3000

# Country code added to local numbers typed without one, e.g. 91 for India, 44 for UK. Leave empty to require "+".
DEFAULT_COUNTRY_CODE=91

# Optional: send the event photo automatically through the official WhatsApp Cloud API (see README).
# Leave these empty and the dashboard gives you a one-tap "Send photo on WhatsApp" button instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=event_photo
WHATSAPP_TEMPLATE_LANG=en
