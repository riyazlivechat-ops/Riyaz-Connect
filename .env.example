# Postgres connection string (Neon, Supabase, Railway, Render all give you one)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/riyaz_connect
# Set to true for hosted Postgres that requires SSL
PGSSL=false
# Password for the private dashboard at /admin
ADMIN_PASSWORD=change-me
# Long random string; keeps you signed in across restarts. Generate: openssl rand -hex 32
SESSION_SECRET=
# The public address of the app. The QR code points here.
PUBLIC_URL=https://connect.example.com
NODE_ENV=production
PORT=3000
